FROM ghcr.io/laude-institute/t-bench/ubuntu-24-04:latest

WORKDIR /root

# Download a simple .deb package (hello package from Debian)
# This package has minimal dependencies
RUN apt-get update && \
    cd /tmp && \
    apt-get download hello && \
    mv hello_*.deb /root/hello_2.10-3_amd64.deb && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*
