FROM ghcr.io/laude-institute/t-bench/ubuntu-24-04:latest

WORKDIR /root

# Copy the files that will be zipped
COPY project_data.txt /tmp/project_data.txt
COPY config.txt /tmp/config.txt

# Create zip files that need to be extracted
RUN apt-get update && apt-get install -y zip && \
    cd /tmp && \
    zip /root/data_archive.zip project_data.txt && \
    zip /root/backup.zip config.txt && \
    rm -rf /var/lib/apt/lists/* && \
    apt-get remove -y zip && \
    apt-get autoremove -y && \
    rm /tmp/project_data.txt /tmp/config.txt

# Note: unzip utility is deliberately NOT installed - agent must install it
